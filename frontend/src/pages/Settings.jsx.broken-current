import { useEffect, useState } from 'react';
import { useTranslation } from 'react-i18next';
import {
  Settings as SettingsIcon,
  Globe,
  Palette,
  Bell,
  Shield,
  Wallet,
  Save,
  RotateCcw,
  CheckCircle2,
  Moon,
  Sun,
  Monitor,
  Eye,
  Mail,
  Activity,
  ShoppingBag,
  AlertTriangle,
  Calendar,
  DollarSign,
} from 'lucide-react';

const STORAGE_KEY = 'mia_pro_settings';
const LANGUAGE_KEY = 'mia_pro_language';

const defaultSettings = {
  language: 'en',
  timezone: 'America/La_Paz',
  dateFormat: 'DD/MM/YYYY',

  theme: 'dark',
  compactMode: false,

  emailNotifications: true,
  activityNotifications: true,
  transactionNotifications: true,
  marketplaceNotifications: true,

  showActivity: true,
  sessionAlerts: true,
  transactionConfirmation: true,

  network: 'Ethereum',
  displayCurrency: 'USD',
  autoConfirm: false,
};

function loadSettings() {
  try {
    const saved = localStorage.getItem(STORAGE_KEY);

    if (!saved) return defaultSettings;

    return {
      ...defaultSettings,
      ...JSON.parse(saved),
    };
  } catch {
    return defaultSettings;
  }
}

function Section ({
    icon: Icon,
    title,
    description,
    children,
}) { return (
    <section
      style={{
        backgroundColor: 'var(--bg-secondary)',
        border: '1px solid var(--border)',
        borderRadius: '14px',
        padding: '1.5rem',
        marginBottom: '1.5rem',
      }}
    >
      <div
        style={{
          display: 'flex',
          alignItems: 'flex-start',
          gap: '0.9rem',
          marginBottom: '1.5rem',
        }}
      >
        <div
          style={{
            width: '42px',
            height: '42px',
            borderRadius: '10px',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center',
            background: 'rgba(16,185,129,0.1)',
            color: 'var(--accent)',
            flexShrink: 0,
          }}
        >
          <Icon size={20} />
        </div>

        <div>
          <h2
            style={{
              margin: 0,
              color: 'var(--text-primary)',
              fontSize: '1.05rem',
            }}
          >
            {title}
          </h2>

          <p
            style={{
              margin: '0.35rem 0 0',
              color: 'var(--text-secondary)',
              fontSize: '0.82rem',
            }}
          >
            {description}
          </p>
        </div>
      </div>

      {children}
    </section>
  );

function Row ({
    icon: Icon,
    title,
    description,
    children,
}) { return (
    <div
      style={{
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'space-between',
        gap: '1rem',
        padding: '1rem 0',
        borderTop: '1px solid var(--border)',
      }}
    >
      <div
        style={{
          display: 'flex',
          alignItems: 'center',
          gap: '0.8rem',
          minWidth: 0,
        }}
      >
        {Icon && (
          <Icon
            size={18}
            style={{
              color: 'var(--text-secondary)',
              flexShrink: 0,
            }}
          />
        )}

        <div>
          <div
            style={{
              color: 'var(--text-primary)',
              fontSize: '0.9rem',
              fontWeight: 600,
            }}
          >
            {title}
          </div>

          <div
            style={{
              color: 'var(--text-secondary)',
              fontSize: '0.76rem',
              marginTop: '0.2rem',
            }}
          >
            {description}
          </div>
        </div>
      </div>

      {children}
    </div>
  );

function Select ({
    value,
    onChange,
    children,
}) { return (
    <select
      value={value}
      onChange={(e) => onChange(e.target.value)}
      style={{
        minWidth: '190px',
        padding: '0.65rem 0.75rem',
        borderRadius: '8px',
        border: '1px solid var(--border)',
        backgroundColor: 'var(--bg-primary)',
        color: 'var(--text-primary)',
        outline: 'none',
      }}
    >
      {children}
    </select>
  );

function Toggle ({
    checked,
    onChange,
}) { return (
    <button
      type="button"
      onClick={() => onChange(!checked)}
      aria-pressed={checked}
      style={{
        width: '46px',
        height: '25px',
        borderRadius: '999px',
        border: 'none',
        padding: '3px',
        cursor: 'pointer',
        backgroundColor: checked
          ? '#10b981'
          : '#475569',
        transition: 'all 0.2s ease',
        flexShrink: 0,
      }}
    >
      <span
        style={{
          display: 'block',
          width: '19px',
          height: '19px',
          borderRadius: '50%',
          background: '#fff',
          transform: checked
            ? 'translateX(21px)'
            : 'translateX(0)',
          transition: 'transform 0.2s ease',
        }}
      />
    </button>
  );
}

export default function Settings() {
  const { i18n } = useTranslation();

  const [settings, setSettings] = useState(loadSettings);
  const [saved, setSaved] = useState(false);

  const isEs = i18n.language?.startsWith('es');

  useEffect(() => {
    const storedLanguage =
      localStorage.getItem(LANGUAGE_KEY) ||
      settings.language ||
      'en';

    if (
      ['es', 'en'].includes(storedLanguage) &&
      i18n.language !== storedLanguage
    ) {
      i18n.changeLanguage(storedLanguage);
    }

    const handleExternalLanguageChange = (event) => {
      const language = event.detail?.language;

      if (!['es', 'en'].includes(language)) return;

      i18n.changeLanguage(language);

      setSettings((current) => ({
        ...current,
        language,
      }));
    };

    window.addEventListener(
      'mia-language-change',
      handleExternalLanguageChange
    );

    return () => {
      window.removeEventListener(
        'mia-language-change',
        handleExternalLanguageChange
      );
    };
  }, []);

  useEffect(() => {
    localStorage.setItem(
      LANGUAGE_KEY,
      settings.language
    );
  }, [settings.language]);

  /*
   * Aplicar idioma al cargar la configuración.
   */
  useEffect(() => {
    if (settings.language && i18n.language !== settings.language) {
      i18n.changeLanguage(settings.language);
    }
  }, []);

  /*
   * Aplicar tema inmediatamente.
   */
  useEffect(() => {
    const root = document.documentElement;

    root.classList.toggle(
      'mia-light-mode',
      settings.theme === 'light'
    );

    if (settings.theme === 'system') {
      const prefersLight = window.matchMedia(
        '(prefers-color-scheme: light)'
      ).matches;

      root.classList.toggle('mia-light-mode', prefersLight);
    }
  }, [settings.theme]);

  const update = (key, value) => {
    setSettings((current) => ({
      ...current,
      [key]: value,
    }));

    setSaved(false);
  };

  const changeLanguage = (language) => {
    update('language', language);
    i18n.changeLanguage(language);

    localStorage.setItem(
      STORAGE_KEY,
      JSON.stringify({
        ...settings,
        language,
      })
    );
  };

  const handleSave = () => {
    localStorage.setItem(
      STORAGE_KEY,
      JSON.stringify(settings)
    );

    localStorage.setItem(
      LANGUAGE_KEY,
      settings.language
    );

    window.dispatchEvent(
      new CustomEvent('mia-settings-change', {
        detail: settings
      })
    );

    i18n.changeLanguage(settings.language);

    setSaved(true);

    setTimeout(() => {
      setSaved(false);
    }, 2500);
  };

  const handleReset = () => {
    if (
      window.confirm(
        isEs
          ? '¿Restaurar toda la configuración a sus valores predeterminados?'
          : 'Reset all settings to their default values?'
      )
    ) {
      setSettings(defaultSettings);

      localStorage.removeItem(STORAGE_KEY);

      i18n.changeLanguage(defaultSettings.language);

      document.documentElement.classList.remove(
        'mia-light-mode'
      );

      setSaved(false);
    }
  };


  return (
    <div
      style={{
        padding: '1rem',
        maxWidth: '1100px',
        margin: '0 auto',
      }}
    >
      {/* HEADER */}

      <div
        style={{
          display: 'flex',
          justifyContent: 'space-between',
          alignItems: 'center',
          gap: '1rem',
          marginBottom: '2rem',
          flexWrap: 'wrap',
        }}
      >
        <div>
          <div
            style={{
              display: 'flex',
              alignItems: 'center',
              gap: '0.7rem',
            }}
          >
            <SettingsIcon
              size={25}
              style={{ color: 'var(--accent)' }}
            />

            <h1
              style={{
                fontSize: '1.6rem',
                color: 'var(--text-primary)',
                margin: 0,
              }}
            >
              {isEs ? 'Configuración' : 'Settings'}
            </h1>
          </div>

          <p
            style={{
              color: 'var(--text-secondary)',
              margin: '0.5rem 0 0 2.1rem',
              fontSize: '0.85rem',
            }}
          >
            {isEs
              ? 'Personaliza tu experiencia en MIA Pro.'
              : 'Customize your MIA Pro experience.'}
          </p>
        </div>

        <div
          style={{
            display: 'flex',
            gap: '0.75rem',
          }}
        >
          <button
            type="button"
            onClick={handleReset}
            style={{
              display: 'flex',
              alignItems: 'center',
              gap: '0.45rem',
              padding: '0.65rem 0.9rem',
              borderRadius: '8px',
              border: '1px solid var(--border)',
              background: 'transparent',
              color: 'var(--text-secondary)',
              cursor: 'pointer',
            }}
          >
            <RotateCcw size={16} />
            {isEs ? 'Restaurar' : 'Reset'}
          </button>

          <button
            type="button"
            onClick={handleSave}
            style={{
              display: 'flex',
              alignItems: 'center',
              gap: '0.45rem',
              padding: '0.65rem 1rem',
              borderRadius: '8px',
              border: 'none',
              background: '#10b981',
              color: '#fff',
              cursor: 'pointer',
              fontWeight: 600,
            }}
          >
            {saved ? (
              <CheckCircle2 size={16} />
            ) : (
              <Save size={16} />
            )}

            {saved
              ? isEs
                ? 'Guardado'
                : 'Saved'
              : isEs
                ? 'Guardar cambios'
                : 'Save changes'}
          </button>
        </div>
      </div>

      {/* GENERAL */}

      <Section
        icon={Globe}
        title={isEs ? 'General' : 'General'}
        description={
          isEs
            ? 'Idioma, región y formatos utilizados por MIA.'
            : 'Language, region and formats used by MIA.'
        }
      >
        <Row
          icon={Globe}
          title={isEs ? 'Idioma' : 'Language'}
          description={
            isEs
              ? 'Idioma principal de la interfaz.'
              : 'Primary interface language.'
          }
        >
          <Select
            value={settings.language}
            onChange={changeLanguage}
          >
            <option value="es">Español</option>
            <option value="en">English</option>
          </Select>
        </Row>

        <Row
          icon={Globe}
          title={isEs ? 'Zona horaria' : 'Time zone'}
          description={
            isEs
              ? 'Zona utilizada para fechas y actividad.'
              : 'Zone used for dates and activity.'
          }
        >
          <Select
            value={settings.timezone}
            onChange={(value) =>
              update('timezone', value)
            }
          >
            <option value="America/La_Paz">
              Bolivia — La Paz
            </option>
            <option value="America/New_York">
              Estados Unidos — Nueva York
            </option>
            <option value="UTC">
              UTC
            </option>
          </Select>
        </Row>

        <Row
          icon={Calendar}
          title={isEs ? 'Formato de fecha' : 'Date format'}
          description={
            isEs
              ? 'Cómo se muestran las fechas.'
              : 'How dates are displayed.'
          }
        >
          <Select
            value={settings.dateFormat}
            onChange={(value) =>
              update('dateFormat', value)
            }
          >
            <option value="DD/MM/YYYY">
              DD/MM/YYYY
            </option>
            <option value="MM/DD/YYYY">
              MM/DD/YYYY
            </option>
            <option value="YYYY-MM-DD">
              YYYY-MM-DD
            </option>
          </Select>
        </Row>
      </Section>

      {/* APARIENCIA */}

      <Section
        icon={Palette}
        title={isEs ? 'Apariencia' : 'Appearance'}
        description={
          isEs
            ? 'Personaliza la apariencia de tu panel.'
            : 'Customize your dashboard appearance.'
        }
      >
        <Row
          icon={
            settings.theme === 'dark'
              ? Moon
              : settings.theme === 'light'
                ? Sun
                : Monitor
          }
          title={isEs ? 'Tema' : 'Theme'}
          description={
            isEs
              ? 'Selecciona el tema visual de MIA.'
              : 'Select the visual MIA theme.'
          }
        >
          <Select
            value={settings.theme}
            onChange={(value) =>
              update('theme', value)
            }
          >
            <option value="dark">
              {isEs ? 'Oscuro' : 'Dark'}
            </option>

            <option value="light">
              {isEs ? 'Claro' : 'Light'}
            </option>

            <option value="system">
              {isEs ? 'Sistema' : 'System'}
            </option>
          </Select>
        </Row>

        <Row
          title={
            isEs
              ? 'Modo compacto'
              : 'Compact mode'
          }
          description={
            isEs
              ? 'Reduce el espacio entre elementos de la interfaz.'
              : 'Reduce spacing between interface elements.'
          }
        >
          <Toggle
            checked={settings.compactMode}
            onChange={(value) =>
              update('compactMode', value)
            }
          />
        </Row>
      </Section>

      {/* NOTIFICACIONES */}

      <Section
        icon={Bell}
        title={isEs ? 'Notificaciones' : 'Notifications'}
        description={
          isEs
            ? 'Controla qué eventos quieres recibir.'
            : 'Control which events you want to receive.'
        }
      >
        <Row
          icon={Mail}
          title={
            isEs
              ? 'Notificaciones por correo'
              : 'Email notifications'
          }
          description={
            isEs
              ? 'Recibir comunicaciones importantes por correo.'
              : 'Receive important communications by email.'
          }
        >
          <Toggle
            checked={settings.emailNotifications}
            onChange={(value) =>
              update('emailNotifications', value)
            }
          />
        </Row>

        <Row
          icon={Activity}
          title={isEs ? 'Actividad' : 'Activity'}
          description={
            isEs
              ? 'Avisos sobre actividad relevante de tu cuenta.'
              : 'Alerts about relevant account activity.'
          }
        >
          <Toggle
            checked={settings.activityNotifications}
            onChange={(value) =>
              update('activityNotifications', value)
            }
          />
        </Row>

        <Row
          icon={Wallet}
          title={
            isEs
              ? 'Transacciones'
              : 'Transactions'
          }
          description={
            isEs
              ? 'Notificaciones sobre operaciones financieras.'
              : 'Notifications about financial operations.'
          }
        >
          <Toggle
            checked={settings.transactionNotifications}
            onChange={(value) =>
              update('transactionNotifications', value)
            }
          />
        </Row>

        <Row
          icon={ShoppingBag}
          title="Marketplace"
          description={
            isEs
              ? 'Avisos relacionados con publicaciones y compras.'
              : 'Alerts related to listings and purchases.'
          }
        >
          <Toggle
            checked={settings.marketplaceNotifications}
            onChange={(value) =>
              update('marketplaceNotifications', value)
            }
          />
        </Row>
      </Section>

      {/* PRIVACIDAD */}

      <Section
        icon={Shield}
        title={
          isEs
            ? 'Privacidad y seguridad'
            : 'Privacy & Security'
        }
        description={
          isEs
            ? 'Controla la visibilidad y seguridad de tu cuenta.'
            : 'Control account visibility and security.'
        }
      >
        <Row
          icon={Eye}
          title={
            isEs
              ? 'Mostrar actividad'
              : 'Show activity'
          }
          description={
            isEs
              ? 'Permitir que la actividad aparezca en el panel.'
              : 'Allow activity to appear on the dashboard.'
          }
        >
          <Toggle
            checked={settings.showActivity}
            onChange={(value) =>
              update('showActivity', value)
            }
          />
        </Row>

        <Row
          icon={AlertTriangle}
          title={
            isEs
              ? 'Alertas de sesión'
              : 'Session alerts'
          }
          description={
            isEs
              ? 'Avisar cuando se detecte una nueva sesión.'
              : 'Alert when a new session is detected.'
          }
        >
          <Toggle
            checked={settings.sessionAlerts}
            onChange={(value) =>
              update('sessionAlerts', value)
            }
          />
        </Row>

        <Row
          icon={Shield}
          title={
            isEs
              ? 'Confirmación de transacciones'
              : 'Transaction confirmation'
          }
          description={
            isEs
              ? 'Solicitar confirmación antes de operaciones importantes.'
              : 'Require confirmation before important operations.'
          }
        >
          <Toggle
            checked={settings.transactionConfirmation}
            onChange={(value) =>
              update('transactionConfirmation', value)
            }
          />
        </Row>
      </Section>

      {/* WEB3 */}

      <Section
        icon={Wallet}
        title="Web3"
        description={
          isEs
            ? 'Preferencias para operaciones blockchain y activos digitales.'
            : 'Preferences for blockchain operations and digital assets.'
        }
      >
        <Row
          icon={Globe}
          title={
            isEs
              ? 'Red principal'
              : 'Primary network'
          }
          description={
            isEs
              ? 'Red utilizada como referencia para operaciones Web3.'
              : 'Network used as the reference for Web3 operations.'
          }
        >
          <Select
            value={settings.network}
            onChange={(value) =>
              update('network', value)
            }
          >
            <option value="Ethereum">
              Ethereum
            </option>

            <option value="Polygon">
              Polygon
            </option>

            <option value="Base">
              Base
            </option>
          </Select>
        </Row>

        <Row
          icon={DollarSign}
          title={
            isEs
              ? 'Moneda de visualización'
              : 'Display currency'
          }
          description={
            isEs
              ? 'Moneda utilizada para mostrar valores.'
              : 'Currency used to display values.'
          }
        >
          <Select
            value={settings.displayCurrency}
            onChange={(value) =>
              update('displayCurrency', value)
            }
          >
            <option value="USD">
              USD — Dólar
            </option>

            <option value="EUR">
              EUR — Euro
            </option>

            <option value="BOB">
              BOB — Boliviano
            </option>
          </Select>
        </Row>

        <Row
          icon={Shield}
          title={
            isEs
              ? 'Confirmación automática'
              : 'Automatic confirmation'
          }
          description={
            isEs
              ? 'Permitir operaciones sin confirmación adicional.'
              : 'Allow operations without additional confirmation.'
          }
        >
          <Toggle
            checked={settings.autoConfirm}
            onChange={(value) =>
              update('autoConfirm', value)
            }
          />
        </Row>
      </Section>

      {/* ESTADO */}

      <div
        style={{
          display: 'flex',
          alignItems: 'center',
          gap: '0.6rem',
          padding: '1rem',
          borderRadius: '10px',
          border: '1px solid var(--border)',
          background: 'rgba(16,185,129,0.05)',
          color: 'var(--text-secondary)',
          fontSize: '0.78rem',
          marginBottom: '2rem',
        }}
      >
        <CheckCircle2
          size={17}
          style={{ color: '#10b981' }}
        />

        {isEs
          ? 'Las preferencias se almacenan localmente en este dispositivo.'
          : 'Preferences are stored locally on this device.'}
      </div>
    </div>
  );
}
